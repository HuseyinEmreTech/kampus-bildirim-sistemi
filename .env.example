# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env repo'ya girmez.
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=buraya-yerel-bir-sifre-yaz
POSTGRES_PORT=5440
# sslmode=disable: yerel PostgreSQL'de SSL yok. max_connection_count: bağlantı havuzu boyutu (verilmezse 1).
# connect_timeout / query_timeout: saniye; verilmezse paket 15 sn ve 5 dk bekler.
DATABASE_URL=postgres://campus:buraya-yerel-bir-sifre-yaz@localhost:5440/campus?sslmode=disable&max_connection_count=10&connect_timeout=5&query_timeout=10
# Yalnızca canlı ortam (compose.prod.yaml): sunucunun kısıtlı veritabanı hesabı.
# Şifre yönetici şifresinden farklı olsun; @ : / ? # karakterlerini kullanma.
APP_DB_USER=campus_app
APP_DB_PASSWORD=buraya-baska-bir-sifre-yaz
# Sunucu JWT sırları (Issue #19). En az 32 karakter, ikisi farklı olmalı. Örnek üretim: openssl rand -base64 48
# Aşağıdaki değerler bilerek kısa: değiştirilmeden kopyalanırsa sunucu açılmaz (herkesin bildiği sırla çalışmasın).
JWT_ACCESS_SECRET=degistir-erisim
JWT_REFRESH_SECRET=degistir-yenileme

# Sunucu bir ters proxy (Nginx, Cloudflare) arkasındaysa proxy'nin IP'leri, virgülle.
# Yalnızca bu adreslerden gelen isteklerde X-Forwarded-For okunur (istek sınırı için gerçek istemci IP'si).
# Proxy yoksa boş bırak.
TRUSTED_PROXIES=

# Kampüs sınırı (Rule 06): dikdörtgenin güneybatı (SW) ve kuzeydoğu (NE) köşeleri, ondalık nokta ile.
# Değerler örnektir; seed ve demo verisindeki binaları her yönde en az 60 m payla kapsar. Gerçek kampüs sınırı doğrulanmadı.
CAMPUS_SW_LAT=36.5840
CAMPUS_SW_LNG=36.1715
CAMPUS_NE_LAT=36.5900
CAMPUS_NE_LNG=36.1770
